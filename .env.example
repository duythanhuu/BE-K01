# Sao chép thành .env (make up tự làm việc này). Không commit .env.
REDIS_PASSWORD=change_me
REDIS_PORT=6379
HTTP_ADDR=:8080
# Đặt true khi chạy sau HTTPS để cookie session chỉ được gửi qua HTTPS.
COOKIE_SECURE=false
# Thời gian /ping xử lý giả lập (đề yêu cầu 5s). Đặt nhỏ hơn để chạy thử nhanh, ví dụ 200ms.
PING_SLEEP=5s
